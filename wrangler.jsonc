{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "88ba2fd1-c0d3-46ce-8ff1-7648b2abfd13","database_name": "web-appaaa" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6527236dbba540e48585b7c809169f7d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
